# solclear environment template
# Copy to .env and fill in. NEVER commit .env. Secrets come only from environment
# variables — the config layer (solclear/config.py) raises MissingSecretError,
# naming the variable, when a required secret is absent.
#
# Helius free-tier indexer key (read-only chain history; no key with trade or
# withdraw capability is used or requested anywhere in this project). Every
# request through the key is metered in credits and gated by
# SOLCLEAR_HELIUS_CREDIT_CAP (ADR-003).
#
# Listed here with no value, on purpose. An empty or whitespace-only value is
# treated as ABSENT by solclear/config.py, so it raises MissingSecretError
# naming this variable rather than sending unauthenticated requests — copying
# this file without filling it in fails loudly, which is the intent.
#
# Scoring from already-computed features needs no key at all; the key is only
# required for the live retrieval path.
SOLCLEAR_HELIUS_API_KEY=

# Self-imposed credit ceiling for the gate (default 30000; raise deliberately,
# never mid-sweep). Reference points: Method B retrieval is ~33-38 credits per
# pool, but the enhanced-transactions step needed for features costs 100
# credits per 100 signatures — roughly 1,450 credits per pool all-in.
# SOLCLEAR_HELIUS_CREDIT_CAP=30000
